<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:DkcDesktopClient.App.I18n"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             x:Class="DkcDesktopClient.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <TextBlock Text="{i18n:T desktop.nav.settings}" FontSize="24" FontWeight="Bold"/>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding StatusMessage}" Foreground="Green"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

      <!-- Server URL -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T desktop.settings.server_configuration}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{i18n:T desktop.login.server_url}"/>
          <Grid ColumnDefinitions="*, Auto">
            <TextBox Grid.Column="0" Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" PlaceholderText="{i18n:T desktop.login.server_placeholder}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="{i18n:T desktop.common.save}" Command="{Binding SaveServerUrlCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Sprache -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T desktop.settings.language}" FontSize="18" FontWeight="SemiBold"/>
          <ComboBox Name="LanguageBox" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" MinWidth="320">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{i18n:T desktop.settings.language_hint}" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Logging -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T desktop.settings.logging}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{i18n:T desktop.settings.log_level}"/>
          <Grid ColumnDefinitions="220,8,Auto,8,Auto,*">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding LogLevelOptions}"
                      SelectedItem="{Binding SelectedLogLevel}"/>
            <Button Grid.Column="2" Content="{i18n:T desktop.common.save}" Command="{Binding SaveLoggingSettingsCommand}"/>
            <Button Grid.Column="4" Content="{i18n:T desktop.common.reload}" Command="{Binding ReloadLoggingSettingsCommand}"/>
          </Grid>
          <TextBlock Text="{i18n:T desktop.settings.log_level_restart}" Foreground="#4A5568"/>
          <TextBlock Text="{Binding LoggingMessage}"
                     Foreground="#2B6CB0"
                     IsVisible="{Binding LoggingMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <!-- Application Update -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{i18n:T desktop.settings.app_update}" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{i18n:T desktop.settings.current_version}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentVersion}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{i18n:T desktop.settings.check_updates}" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingForUpdates}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingForUpdates}" Width="120" Height="16" VerticalAlignment="Center"/>
          </StackPanel>
          <Border IsVisible="{Binding AvailableUpdate, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Background="#90CDF4" BorderBrush="#3182CE" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{i18n:T desktop.settings.new_version}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AvailableUpdate.TagName}" FontWeight="Bold" Foreground="#2B6CB0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding AvailableUpdate.ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{i18n:T desktop.settings.release_notes}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}" TextWrapping="Wrap" MaxHeight="120"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                             IsVisible="{Binding IsDownloadingUpdate}" Height="8"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{i18n:T desktop.settings.download_install}" Command="{Binding DownloadUpdateCommand}"
                          Background="#3182CE" Foreground="White" IsEnabled="{Binding !IsDownloadingUpdate}"/>
                  <TextBlock IsVisible="{Binding IsDownloadingUpdate}"
                             Text="{Binding DownloadProgress, StringFormat={}{0:F0}%}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- API Tokens -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{i18n:T desktop.settings.api_tokens}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="{i18n:T desktop.common.refresh}" Command="{Binding LoadTokensCommand}"/>
            <Button Content="{i18n:T desktop.settings.delete_selected}" Command="{Binding DeleteTokenCommand}" Foreground="Red"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Tokens}" SelectedItem="{Binding SelectedToken}" IsReadOnly="True" AutoGenerateColumns="False" Height="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.id}" Binding="{Binding Id}" Width="60"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.name}" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.settings.expires_at}" Binding="{Binding ExpiresAt}" Width="150"/>
              <DataGridTextColumn Header="{i18n:T desktop.settings.last_used}" Binding="{Binding LastUsedAt}" Width="150"/>
              <DataGridTextColumn Header="{i18n:T desktop.settings.last_ip}" Binding="{Binding LastIp}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.created}" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Passwort ändern -->
      <Border Name="PasswordSection" BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16"
              IsVisible="{Binding CanChangePassword}">
        <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
          <TextBlock Text="{i18n:T desktop.settings.change_password}" FontSize="18" FontWeight="SemiBold"/>
          <TextBox Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" PasswordChar="●" PlaceholderText="{i18n:T desktop.settings.current_password}"/>
          <TextBox Name="NewPasswordBox" Text="{Binding NewPassword}" PasswordChar="●" PlaceholderText="{i18n:T desktop.settings.new_password}"/>
          <TextBox Name="NewPasswordRepeatBox" Text="{Binding NewPasswordRepeat}" PasswordChar="●" PlaceholderText="{i18n:T desktop.settings.repeat_password}"/>
          <TextBlock Name="PasswordErrorText" Text="{Binding PasswordError}" Foreground="#C53030" TextWrapping="Wrap"
                     IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Name="PasswordMessageText" Text="{Binding PasswordMessage}" Foreground="#2F855A"
                     IsVisible="{Binding PasswordMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Button Name="ChangePasswordButton" Content="{i18n:T desktop.settings.change_password}" Command="{Binding ChangePasswordCommand}"/>
        </StackPanel>
      </Border>

      <!-- Projects -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{i18n:T desktop.settings.projects}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="{i18n:T desktop.common.refresh}" Command="{Binding LoadProjectsCommand}"/>
            <Button Content="{i18n:T desktop.settings.new_project}" Command="{Binding ShowCreateProjectFormCommand}"/>
            <Button Content="{i18n:T desktop.settings.edit_project}" Command="{Binding ShowEditProjectFormCommand}"/>
            <Button Content="{i18n:T desktop.settings.set_active}" Command="{Binding SetActiveProjectCommand}"/>
          </StackPanel>

          <!-- Project form -->
          <Border IsVisible="{Binding IsProjectFormVisible}"
                  Background="#CBD5E0" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="4" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding ProjectFormError}" Foreground="Red"
                         IsVisible="{Binding ProjectFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Grid ColumnDefinitions="80,8,*,16,80,8,*">
                <TextBlock Grid.Column="0" Text="{i18n:T desktop.common.name_required}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" Text="{Binding FormProjectName}" PlaceholderText="{i18n:T desktop.settings.project_name_placeholder}"/>
                <TextBlock Grid.Column="4" Text="{i18n:T desktop.common.description}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="6" Text="{Binding FormProjectDescription}" PlaceholderText="{i18n:T desktop.common.description}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{i18n:T desktop.common.save}" Command="{Binding SaveProjectCommand}"/>
                <Button Content="{i18n:T desktop.common.cancel}" Command="{Binding CancelProjectFormCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingProject}" Width="60" Height="14" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.id}" Binding="{Binding Id}" Width="60"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.name}" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.description}" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Admin: Users (only shown for admins) -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16"
              IsVisible="{Binding IsAdmin}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{i18n:T desktop.settings.users_admin}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="{i18n:T desktop.common.refresh}" Command="{Binding LoadUsersCommand}"/>
            <Button Content="{i18n:T desktop.settings.new_user}" Command="{Binding ShowCreateUserFormCommand}"/>
            <Button Content="{i18n:T desktop.settings.edit_user}" Command="{Binding ShowEditUserFormCommand}"/>
            <Button Content="{i18n:T desktop.settings.delete_user}" Command="{Binding DeleteUserCommand}" Foreground="Red"/>
          </StackPanel>

          <!-- User form -->
          <Border IsVisible="{Binding IsUserFormVisible}"
                  Background="#FAF089" BorderThickness="1" BorderBrush="#F6C90E" CornerRadius="4" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding UserFormError}" Foreground="Red"
                         IsVisible="{Binding UserFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Grid ColumnDefinitions="80,8,*,16,80,8,*" RowDefinitions="Auto,8,Auto,8,Auto" RowSpacing="0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:T desktop.settings.username_required}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding FormUsername}" PlaceholderText="{i18n:T desktop.settings.username_placeholder}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{i18n:T desktop.common.password}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding FormPassword}" PasswordChar="*" PlaceholderText="{i18n:T desktop.settings.password_keep}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:T desktop.settings.first_name}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FormVname}" PlaceholderText="{i18n:T desktop.settings.first_name}"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="{i18n:T desktop.settings.last_name}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="6" Text="{Binding FormNname}" PlaceholderText="{i18n:T desktop.settings.last_name}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{i18n:T desktop.common.email}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding FormEmail}" PlaceholderText="{i18n:T desktop.common.email_address}"/>
                <TextBlock Grid.Row="4" Grid.Column="4" Text="{i18n:T desktop.settings.is_admin}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="4" Grid.Column="6" IsChecked="{Binding FormIsAdmin}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{i18n:T desktop.common.save}" Command="{Binding SaveUserCommand}"/>
                <Button Content="{i18n:T desktop.common.cancel}" Command="{Binding CancelUserFormCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingUser}" Width="60" Height="14" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" IsReadOnly="True" AutoGenerateColumns="False" Height="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.id}" Binding="{Binding Id}" Width="60"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.username}" Binding="{Binding Username}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.settings.first_name}" Binding="{Binding Vname}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.settings.last_name}" Binding="{Binding Nname}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.email}" Binding="{Binding Email}" Width="*"/>
              <DataGridCheckBoxColumn Header="{i18n:T desktop.common.admin}" Binding="{Binding IsAdmin}" Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Admin: API status check -->
      <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="8" Padding="16"
              IsVisible="{Binding IsAdmin}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{i18n:T desktop.settings.api_status}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="{i18n:T desktop.settings.run_status_check}" Command="{Binding RunApiStatusCheckCommand}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunningApiStatusCheck}" Width="120" Height="14" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{i18n:T desktop.settings.status_check_hint}"
                     Foreground="#4A5568"/>
          <DataGrid ItemsSource="{Binding ApiStatusItems}" IsReadOnly="True" AutoGenerateColumns="False" Height="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.settings.endpoint}" Binding="{Binding Endpoint}" Width="180"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.status}" Binding="{Binding Status}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.details}" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

