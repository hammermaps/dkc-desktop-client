<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:DkcDesktopClient.App.I18n"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             xmlns:api="using:DkcDesktopClient.Core.Api"
             x:Class="DkcDesktopClient.App.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">

  <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="16" RowSpacing="8">

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{i18n:T desktop.notifications.title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="{i18n:T desktop.common.refresh}" Command="{Binding LoadNotificationsCommand}"/>
      <Button Content="{i18n:T desktop.notifications.mark_all_read}" Command="{Binding MarkAllReadCommand}"
              IsEnabled="{Binding HasUnreadNotifications}"/>
      <Border Background="#3B82F6" CornerRadius="12" Padding="8,3"
              IsVisible="{Binding HasUnreadNotifications}">
        <TextBlock Text="{Binding TotalCount, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.notifications.unread_count|count}"
                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
      </Border>
    </StackPanel>

    <!-- Filter bar -->
    <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{i18n:T desktop.notifications.unread_only}" VerticalAlignment="Center"/>
        <CheckBox IsChecked="{Binding ShowUnreadOnly}"/>
        <TextBlock Text="{Binding Notifications.Count, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.notifications.shown_count|count}"
                   VerticalAlignment="Center" Foreground="#4A5568"/>
      </StackPanel>
    </Border>

    <!-- Error / Progress -->
    <Grid Grid.Row="2">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Bottom"/>
    </Grid>

    <!-- Notification list -->
    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding Notifications}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="api:NotificationItem">
            <Border Margin="0,4" Padding="14,10"
                    CornerRadius="6" BorderThickness="1"
                    Background="#FAFAFA"
                    BorderBrush="#E2E8F0">
              <Grid ColumnDefinitions="*,12,Auto">
                <!-- Content -->
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Message}" Foreground="#4A5568" FontSize="13" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Type}" Foreground="#718096" FontSize="11"
                               IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding CreatedAt}" Foreground="#718096" FontSize="11"/>
                  </StackPanel>
                </StackPanel>

                <!-- Read badge -->
                <StackPanel Grid.Column="2" Spacing="4" IsVisible="{Binding !Read}">
                  <Border CornerRadius="10" Padding="8,3" Background="#3B82F6" HorizontalAlignment="Right">
                    <TextBlock Text="{i18n:T desktop.common.new}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                  <Button Content="{i18n:T desktop.notifications.read}" FontSize="11" Padding="8,2"
                          Command="{Binding $parent[ItemsControl].((vm:NotificationsViewModel)DataContext).MarkReadCommand}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</UserControl>

