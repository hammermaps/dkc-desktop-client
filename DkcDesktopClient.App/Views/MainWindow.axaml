<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DkcDesktopClient.App.ViewModels"
        xmlns:views="using:DkcDesktopClient.App.Views"
        xmlns:controls="using:DkcDesktopClient.App.Controls"
        x:Class="DkcDesktopClient.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DK-Control Desktop Client"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource ContentBackgroundBrush}">

  <!-- ── Global Keyboard Shortcuts ────────────────────────────────────────── -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateToModuleCommand}" CommandParameter="1"/>
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateToModuleCommand}" CommandParameter="2"/>
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateToModuleCommand}" CommandParameter="3"/>
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateToModuleCommand}" CommandParameter="4"/>
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateToModuleCommand}" CommandParameter="5"/>
    <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateToModuleCommand}" CommandParameter="6"/>
    <KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateToModuleCommand}" CommandParameter="7"/>
    <KeyBinding Gesture="Ctrl+8" Command="{Binding NavigateToModuleCommand}" CommandParameter="8"/>
    <KeyBinding Gesture="Ctrl+9" Command="{Binding NavigateToModuleCommand}" CommandParameter="9"/>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCurrentModuleCommand}"/>
  </Window.KeyBindings>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
      <views:LoginView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NeaViewModel}">
      <views:NeaView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MmViewModel}">
      <views:MmView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BuildingViewModel}">
      <views:BuildingView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KlimaViewModel}">
      <views:KlimaView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KeysViewModel}">
      <views:KeysView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WlsViewModel}">
      <views:WlsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
      <views:NotificationsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView/>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <ContentControl Content="{Binding CurrentView}" IsVisible="{Binding !IsLoggedIn}"/>

    <SplitView IsPaneOpen="{Binding IsPaneOpen}"
               DisplayMode="Inline"
               PaneBackground="{DynamicResource SidebarBackgroundBrush}"
               OpenPaneLength="248"
               IsVisible="{Binding IsLoggedIn}">
      <SplitView.Pane>
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Margin="16,18,16,14" ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto">
            <Border Grid.RowSpan="2" Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                    Background="{DynamicResource AccentBlueBrush}">
              <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="DK-Control" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserDisplayName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
            <controls:NotificationBadge Grid.Column="2" Grid.RowSpan="2" Count="{Binding UnreadNotificationCount}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,16" Spacing="10">
            <Border Height="1" Background="#334155"/>
            <Button Content="Logout" Command="{Binding LogoutCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Classes="danger"/>
          </StackPanel>

          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   Background="Transparent"
                   Margin="8,0,8,8">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Grid ColumnDefinitions="4,30,*" Margin="0,2" MinHeight="38">
                  <Border Grid.Column="0" Classes="nav-indicator" Background="{DynamicResource AccentBlueBrush}"
                          CornerRadius="2" IsVisible="False"/>
                  <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Classes="nav-title" Text="{Binding Title}" Foreground="{DynamicResource SidebarForegroundBrush}"
                             FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="ListBoxItem /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="8"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#27304A"/>
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#2D3A5C"/>
              </Style>
              <Style Selector="ListBoxItem:selected Border.nav-indicator">
                <Setter Property="IsVisible" Value="True"/>
              </Style>
              <Style Selector="ListBoxItem:selected TextBlock.nav-title">
                <Setter Property="Foreground" Value="{DynamicResource SidebarForegroundActiveBrush}"/>
              </Style>
            </ListBox.Styles>
          </ListBox>
        </DockPanel>
      </SplitView.Pane>

      <Grid RowDefinitions="Auto, *" Background="{DynamicResource ContentBackgroundBrush}">
        <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColorBrush}" Padding="10,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="☰" Command="{Binding TogglePaneCommand}" Width="36" Height="32"
                    AutomationProperties.Name="Navigation umschalten"
                    ToolTip.Tip="Navigation umschalten"/>
            <!-- Offline indicator -->
            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4"
                    Padding="8,4" VerticalAlignment="Center"
                    IsVisible="{Binding IsOffline}"
                    ToolTip.Tip="Server nicht erreichbar – Daten aus Cache werden angezeigt">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="⚠" Foreground="#DC2626" VerticalAlignment="Center"/>
                <TextBlock Text="Offline" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto, *">
          <Border Grid.Row="0"
                  Background="#FEFCBF" BorderBrush="#D69E2E" BorderThickness="0,0,0,1" Padding="10,8"
                  IsVisible="{Binding AvailableUpdate, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Details" Command="{Binding ShowUpdateInSettingsCommand}"
                        Background="#D69E2E" Foreground="White" Padding="8,4"/>
                <Button Content="✕" Command="{Binding DismissUpdateCommand}"
                        Background="Transparent" Padding="6,4"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="🔔" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center">
                  <Run Text="Update available: "/>
                  <Run Text="{Binding AvailableUpdate.TagName}" FontWeight="Bold"/>
                  <Run Text=" — Go to Settings to install."/>
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </Border>
          <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
      </Grid>
    </SplitView>
  </Grid>
</Window>
