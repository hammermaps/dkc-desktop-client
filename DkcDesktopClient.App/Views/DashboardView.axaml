<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             xmlns:api="using:DkcDesktopClient.Core.Api"
             xmlns:controls="using:DkcDesktopClient.App.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="DkcDesktopClient.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer Background="{DynamicResource ContentBackgroundBrush}">
    <StackPanel Margin="24" Spacing="18">
      <DockPanel LastChildFill="True">
        <controls:RefreshIndicator DockPanel.Dock="Right" IsRefreshing="{Binding IsRefreshing}" Margin="12,12,0,0"/>
        <StackPanel>
          <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Übersicht über aktuelle Kennzahlen und Prüfungen" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </DockPanel>

      <!-- Project quick-switch -->
      <Border Classes="card" Background="#F0F9FF" BorderBrush="#BAE6FD" IsVisible="{Binding Projects.Count}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Aktives Projekt:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject}"
                    MinWidth="240">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="api:Project">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Als aktiv setzen" Command="{Binding SetActiveProjectCommand}" Classes="primary"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSettingProject}" Width="60" Height="14" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

      <!-- Stats tiles -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <controls:StatCard Grid.Column="0" Title="Mängelmeldungen" Value="{Binding MmTotalText}" Icon="🔧" BackgroundColor="#EFF6FF"
                           ToolTip.Tip="Gesamtzahl der geladenen Mängelmeldungen"/>
        <controls:StatCard Grid.Column="1" Title="NEA-Systeme" Value="{Binding NeaTotalSystemsText}" Icon="⚡" BackgroundColor="#EEF2FF"
                           ToolTip.Tip="Gesamtzahl der NEA-Systeme"/>
        <controls:StatCard Grid.Column="2" Title="Schlüssel verfügbar" Value="{Binding KeysAvailableText}" Icon="🔑" BackgroundColor="#ECFDF5" TrendColor="#10B981"
                           ToolTip.Tip="Anzahl verfügbarer Schlüssel"/>
        <controls:StatCard Grid.Column="3" Title="Überfällige Prüfungen" Value="{Binding NeaOverdueInspectionsText}" Icon="⚠" BackgroundColor="#FEF2F2" TrendColor="#EF4444"
                           ToolTip.Tip="Anzahl überfälliger NEA-Prüfungen"/>
      </Grid>

      <!-- MM stats row -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="0">
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="Offen" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmOpenText}" FontSize="28" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#E2E8F0"/>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="In Bearbeitung" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmInProgress}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="3" Background="#E2E8F0"/>
          <StackPanel Grid.Column="4" HorizontalAlignment="Center">
            <TextBlock Text="Gesamt" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmTotalText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Web-Dashboard-Kacheln (dashboard_overview.tpl): Sammelstörung, Ausgegebene Schlüssel, Ø Temperatur -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <controls:StatCard Grid.Column="0" Title="Sammelstörung" Value="{Binding SammelstoerungCountText}" Icon="🚨" BackgroundColor="#FEF2F2" TrendColor="#EF4444"
                           IsVisible="{Binding SammelstoerungPermission}" ToolTip.Tip="Aktive Störungen über Klima/SiBe/KinCony/RCO"/>
        <controls:StatCard Grid.Column="1" Title="Ausgegebene Schlüssel" Value="{Binding IssuedKeysCountText}" Icon="🔑" BackgroundColor="#ECFDF5"
                           IsVisible="{Binding IssuedKeysPermission}" ToolTip.Tip="Aktuell ausgegebene Schlüssel/Bunde"/>
        <controls:StatCard Grid.Column="2" Title="Ø Temperatur" Value="{Binding TemperatureAverageText}" Icon="🌡" BackgroundColor="#EFF6FF"
                           IsVisible="{Binding TemperaturePermission}" ToolTip.Tip="Durchschnittstemperatur laufender Klimageräte"/>
      </Grid>

      <Border Classes="card" IsVisible="{Binding TemperaturePermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="Temperaturverlauf (14 Tage)" FontSize="18" FontWeight="SemiBold"/>
          <lvc:CartesianChart Series="{Binding TemperatureSeries}"
                               XAxes="{Binding TemperatureXAxes}"
                               YAxes="{Binding TemperatureYAxes}"
                               Height="220"/>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding SammelstoerungPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="Sammelstörung" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Keine aktiven Störungen" IsVisible="{Binding !HasSammelstoerung}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <DataGrid ItemsSource="{Binding Sammelstoerung}" IsReadOnly="True" AutoGenerateColumns="False" Height="160" IsVisible="{Binding HasSammelstoerung}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Quelle" Binding="{Binding SourceLabel}" Width="100"/>
              <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceName}" Width="*"/>
              <DataGridTextColumn Header="Meldung" Binding="{Binding AlarmText}" Width="2*"/>
              <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IssuedKeysPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="Ausgegebene Schlüssel" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding IssuedKeysList}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name/Nr." Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Empfänger" Binding="{Binding EmpfaengerName}" Width="*"/>
              <DataGridTextColumn Header="Ausgegeben am" Binding="{Binding AusgegebenAm}" Width="150"/>
              <DataGridTextColumn Header="Rückgabe geplant" Binding="{Binding RueckgabeGeplant}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ApprovalsPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="Offene Freigaben" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding Approvals}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="Nachunternehmer" Binding="{Binding NachunternehmerName}" Width="160"/>
              <DataGridTextColumn Header="Tage wartend" Binding="{Binding DaysWaiting}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" Background="#FFFBEB" BorderBrush="#F59E0B" IsVisible="{Binding OverdueComplaintsPermission}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" FontSize="18"/>
            <TextBlock Text="Überfällige Mängelmeldungen" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding OverdueComplaints}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="140"/>
              <DataGridTextColumn Header="Tage offen" Binding="{Binding DaysOpen}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding WlsPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="WLS-Spülungen fällig" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding WlsFlushings}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Wohnung" Binding="{Binding Label}" Width="*"/>
              <DataGridTextColumn Header="Gebäude" Binding="{Binding BuildingName}" Width="*"/>
              <DataGridTextColumn Header="Letzte Spülung" Binding="{Binding LastFlushDate}" Width="140"/>
              <DataGridTextColumn Header="Tage überfällig" Binding="{Binding DaysOverdue}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" Background="#FFFBEB" BorderBrush="#F59E0B" IsVisible="{Binding HasOverdueItems}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" FontSize="18"/>
            <TextBlock Text="Überfällige NEA-Prüfungen" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding OverdueItems}" IsReadOnly="True" AutoGenerateColumns="False" Height="190">
            <DataGrid.Columns>
              <DataGridTextColumn Header="System" Binding="{Binding SystemName}" Width="*"/>
              <DataGridTextColumn Header="Tage überfällig" Binding="{Binding DaysOverdue}" Width="140"/>
              <DataGridTextColumn Header="Letzte Prüfung" Binding="{Binding LastInspection}" Width="160"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Neue Mängelmeldung" Command="{Binding CreateMmCommand}" Classes="primary"/>
            <Button Content="NEA-Prüfung starten" Command="{Binding StartNeaInspectionCommand}" Classes="primary"/>
            <Button Content="Dashboard neu laden" Command="{Binding LoadDataCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Letzte NEA-Prüfungen" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding RecentInspections}" IsReadOnly="True" AutoGenerateColumns="False" Height="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Datum" Binding="{Binding InspectionDate}" Width="120"/>
              <DataGridTextColumn Header="Prüfer" Binding="{Binding InspectorName}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
              <DataGridTextColumn Header="Ergebnis" Binding="{Binding OverallResult}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
