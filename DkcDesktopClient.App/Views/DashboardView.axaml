<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:DkcDesktopClient.App.I18n"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             xmlns:api="using:DkcDesktopClient.Core.Api"
             xmlns:controls="using:DkcDesktopClient.App.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="DkcDesktopClient.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer Background="{DynamicResource ContentBackgroundBrush}">
    <StackPanel Margin="24" Spacing="18">
      <DockPanel LastChildFill="True">
        <controls:RefreshIndicator DockPanel.Dock="Right" IsRefreshing="{Binding IsRefreshing}" Margin="12,12,0,0"/>
        <StackPanel>
          <TextBlock Text="{i18n:T desktop.nav.dashboard}" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="{i18n:T desktop.dashboard.subtitle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </DockPanel>

      <!-- Project quick-switch -->
      <Border Classes="card" Background="#F0F9FF" BorderBrush="#BAE6FD" IsVisible="{Binding Projects.Count}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.active_project}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject}"
                    MinWidth="240">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="api:Project">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{i18n:T desktop.dashboard.set_active}" Command="{Binding SetActiveProjectCommand}" Classes="primary"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSettingProject}" Width="60" Height="14" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

      <!-- Stats tiles -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <controls:StatCard Grid.Column="0" Title="{i18n:T desktop.nav.mm}" Value="{Binding MmTotalText}" Icon="🔧" BackgroundColor="#EFF6FF"
                           ToolTip.Tip="{i18n:T desktop.dashboard.mm_total_tip}"/>
        <controls:StatCard Grid.Column="1" Title="{i18n:T desktop.dashboard.nea_systems}" Value="{Binding NeaTotalSystemsText}" Icon="⚡" BackgroundColor="#EEF2FF"
                           ToolTip.Tip="{i18n:T desktop.dashboard.nea_systems_tip}"/>
        <controls:StatCard Grid.Column="2" Title="{i18n:T desktop.dashboard.keys_available}" Value="{Binding KeysAvailableText}" Icon="🔑" BackgroundColor="#ECFDF5" TrendColor="#10B981"
                           ToolTip.Tip="{i18n:T desktop.dashboard.keys_available_tip}"/>
        <controls:StatCard Grid.Column="3" Title="{i18n:T desktop.dashboard.overdue_inspections}" Value="{Binding NeaOverdueInspectionsText}" Icon="⚠" BackgroundColor="#FEF2F2" TrendColor="#EF4444"
                           ToolTip.Tip="{i18n:T desktop.dashboard.overdue_inspections_tip}"/>
      </Grid>

      <!-- MM stats row -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="0">
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="{i18n:T desktop.common.open}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmOpenText}" FontSize="28" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#E2E8F0"/>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="{i18n:T desktop.common.in_progress}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmInProgress}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="3" Background="#E2E8F0"/>
          <StackPanel Grid.Column="4" HorizontalAlignment="Center">
            <TextBlock Text="{i18n:T desktop.common.total}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmTotalText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Web-Dashboard-Kacheln (dashboard_overview.tpl): Sammelstörung, Ausgegebene Schlüssel, Ø Temperatur -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <controls:StatCard Grid.Column="0" Title="{i18n:T desktop.dashboard.collective_fault}" Value="{Binding SammelstoerungCountText}" Icon="🚨" BackgroundColor="#FEF2F2" TrendColor="#EF4444"
                           IsVisible="{Binding SammelstoerungPermission}" ToolTip.Tip="{i18n:T desktop.dashboard.collective_fault_tip}"/>
        <controls:StatCard Grid.Column="1" Title="{i18n:T desktop.dashboard.issued_keys}" Value="{Binding IssuedKeysCountText}" Icon="🔑" BackgroundColor="#ECFDF5"
                           IsVisible="{Binding IssuedKeysPermission}" ToolTip.Tip="{i18n:T desktop.dashboard.issued_keys_tip}"/>
        <controls:StatCard Grid.Column="2" Title="{i18n:T desktop.dashboard.avg_temperature}" Value="{Binding TemperatureAverageText}" Icon="🌡" BackgroundColor="#EFF6FF"
                           IsVisible="{Binding TemperaturePermission}" ToolTip.Tip="{i18n:T desktop.dashboard.avg_temperature_tip}"/>
      </Grid>

      <Border Classes="card" IsVisible="{Binding TemperaturePermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.temperature_history}" FontSize="18" FontWeight="SemiBold"/>
          <lvc:CartesianChart Series="{Binding TemperatureSeries}"
                               XAxes="{Binding TemperatureXAxes}"
                               YAxes="{Binding TemperatureYAxes}"
                               Height="220"/>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding SammelstoerungPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.collective_fault}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{i18n:T desktop.dashboard.no_faults}" IsVisible="{Binding !HasSammelstoerung}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <DataGrid ItemsSource="{Binding Sammelstoerung}" IsReadOnly="True" AutoGenerateColumns="False" Height="160" IsVisible="{Binding HasSammelstoerung}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.source}" Binding="{Binding SourceLabel}" Width="100"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.device}" Binding="{Binding DeviceName}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.message}" Binding="{Binding AlarmText}" Width="2*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.time}" Binding="{Binding Timestamp}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IssuedKeysPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.issued_keys}" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding IssuedKeysList}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.dashboard.name_no}" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.recipient}" Binding="{Binding EmpfaengerName}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.issued_at}" Binding="{Binding AusgegebenAm}" Width="150"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.return_planned}" Binding="{Binding RueckgabeGeplant}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ApprovalsPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.open_approvals}" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding Approvals}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.address}" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.title}" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.contractor}" Binding="{Binding NachunternehmerName}" Width="160"/>
              <DataGridTextColumn Header="{i18n:T desktop.dashboard.days_waiting}" Binding="{Binding DaysWaiting}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" Background="#FFFBEB" BorderBrush="#F59E0B" IsVisible="{Binding OverdueComplaintsPermission}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" FontSize="18"/>
            <TextBlock Text="{i18n:T desktop.dashboard.overdue_mm}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding OverdueComplaints}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.address}" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.title}" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.status}" Binding="{Binding StatusLabel}" Width="140"/>
              <DataGridTextColumn Header="{i18n:T desktop.dashboard.days_open}" Binding="{Binding DaysOpen}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding WlsPermission}">
        <StackPanel Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.wls_due}" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding WlsFlushings}" IsReadOnly="True" AutoGenerateColumns="False" Height="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.apartment}" Binding="{Binding Label}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.building}" Binding="{Binding BuildingName}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.dashboard.last_flush}" Binding="{Binding LastFlushDate}" Width="140"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.days_overdue}" Binding="{Binding DaysOverdue}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card" Background="#FFFBEB" BorderBrush="#F59E0B" IsVisible="{Binding HasOverdueItems}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" FontSize="18"/>
            <TextBlock Text="{i18n:T desktop.dashboard.overdue_nea}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding OverdueItems}" IsReadOnly="True" AutoGenerateColumns="False" Height="190">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.system}" Binding="{Binding SystemName}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.days_overdue}" Binding="{Binding DaysOverdue}" Width="140"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.last_inspection}" Binding="{Binding LastInspection}" Width="160"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{i18n:T desktop.dashboard.quick_actions}" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{i18n:T desktop.dashboard.new_mm}" Command="{Binding CreateMmCommand}" Classes="primary"/>
            <Button Content="{i18n:T desktop.dashboard.start_nea}" Command="{Binding StartNeaInspectionCommand}" Classes="primary"/>
            <Button Content="{i18n:T desktop.dashboard.reload}" Command="{Binding LoadDataCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{i18n:T desktop.dashboard.last_nea}" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding RecentInspections}" IsReadOnly="True" AutoGenerateColumns="False" Height="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.date}" Binding="{Binding InspectionDate}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.inspector}" Binding="{Binding InspectorName}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.status}" Binding="{Binding Status}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.result}" Binding="{Binding OverallResult}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
