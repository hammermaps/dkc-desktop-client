<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             xmlns:api="using:DkcDesktopClient.Core.Api"
             xmlns:controls="using:DkcDesktopClient.App.Controls"
             x:Class="DkcDesktopClient.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer Background="{DynamicResource ContentBackgroundBrush}">
    <StackPanel Margin="24" Spacing="18">
      <DockPanel LastChildFill="True">
        <controls:RefreshIndicator DockPanel.Dock="Right" IsRefreshing="{Binding IsRefreshing}" Margin="12,12,0,0"/>
        <StackPanel>
          <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Übersicht über aktuelle Kennzahlen und Prüfungen" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </DockPanel>

      <!-- Project quick-switch -->
      <Border Classes="card" Background="#F0F9FF" BorderBrush="#BAE6FD" IsVisible="{Binding Projects.Count}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Aktives Projekt:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject}"
                    MinWidth="240">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="api:Project">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Als aktiv setzen" Command="{Binding SetActiveProjectCommand}" Classes="primary"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSettingProject}" Width="60" Height="14" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

      <!-- Stats tiles -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <controls:StatCard Grid.Column="0" Title="Mängelmeldungen" Value="{Binding MmTotalText}" Icon="🔧" BackgroundColor="#EFF6FF"
                           ToolTip.Tip="Gesamtzahl der geladenen Mängelmeldungen"/>
        <controls:StatCard Grid.Column="1" Title="NEA-Systeme" Value="{Binding NeaTotalSystemsText}" Icon="⚡" BackgroundColor="#EEF2FF"
                           ToolTip.Tip="Gesamtzahl der NEA-Systeme"/>
        <controls:StatCard Grid.Column="2" Title="Schlüssel verfügbar" Value="{Binding KeysAvailableText}" Icon="🔑" BackgroundColor="#ECFDF5" TrendColor="#10B981"
                           ToolTip.Tip="Anzahl verfügbarer Schlüssel"/>
        <controls:StatCard Grid.Column="3" Title="Überfällige Prüfungen" Value="{Binding NeaOverdueInspectionsText}" Icon="⚠" BackgroundColor="#FEF2F2" TrendColor="#EF4444"
                           ToolTip.Tip="Anzahl überfälliger NEA-Prüfungen"/>
      </Grid>

      <!-- MM stats row -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="0">
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="Offen" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmOpenText}" FontSize="28" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#E2E8F0"/>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="In Bearbeitung" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmInProgress}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="3" Background="#E2E8F0"/>
          <StackPanel Grid.Column="4" HorizontalAlignment="Center">
            <TextBlock Text="Gesamt" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MmTotalText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Background="#FFFBEB" BorderBrush="#F59E0B" IsVisible="{Binding HasOverdueItems}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" FontSize="18"/>
            <TextBlock Text="Überfällige NEA-Prüfungen" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding OverdueItems}" IsReadOnly="True" AutoGenerateColumns="False" Height="190">
            <DataGrid.Columns>
              <DataGridTextColumn Header="System" Binding="{Binding SystemName}" Width="*"/>
              <DataGridTextColumn Header="Tage überfällig" Binding="{Binding DaysOverdue}" Width="140"/>
              <DataGridTextColumn Header="Letzte Prüfung" Binding="{Binding LastInspection}" Width="160"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Neue Mängelmeldung" Command="{Binding CreateMmCommand}" Classes="primary"/>
            <Button Content="NEA-Prüfung starten" Command="{Binding StartNeaInspectionCommand}" Classes="primary"/>
            <Button Content="Dashboard neu laden" Command="{Binding LoadDataCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Letzte NEA-Prüfungen" FontSize="18" FontWeight="SemiBold"/>
          <DataGrid ItemsSource="{Binding RecentInspections}" IsReadOnly="True" AutoGenerateColumns="False" Height="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Datum" Binding="{Binding InspectionDate}" Width="120"/>
              <DataGridTextColumn Header="Prüfer" Binding="{Binding InspectorName}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
              <DataGridTextColumn Header="Ergebnis" Binding="{Binding OverallResult}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
