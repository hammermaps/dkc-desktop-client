<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             xmlns:api="using:DkcDesktopClient.Core.Api"
             xmlns:controls="using:DkcDesktopClient.App.Controls"
             x:Class="DkcDesktopClient.App.Views.MmView"
             x:DataType="vm:MmViewModel">

  <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, 6, Auto" Margin="16" RowSpacing="8">

    <!-- ═══════════════════════════════════  Toolbar  ═══════════════════════════════════ -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Mängelmeldungen" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="Laden" Command="{Binding LoadMessagesCommand}"/>
      <Button Content="Neue Meldung" Command="{Binding ShowCreateFormCommand}"/>
      <Button Content="Bearbeiten" Command="{Binding ShowEditFormCommand}"/>
      <Button Content="Löschen" Command="{Binding DeleteCommand}" Foreground="Red"/>
      <Button Content="📥 CSV-Export" Command="{Binding ExportMessagesToCsvCommand}"
              ToolTip.Tip="Aktuelle Liste als CSV exportieren"/>
    </StackPanel>

    <!-- ═══════════════════════════════  Filter-Leiste  ════════════════════════════════ -->
    <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Spacing="6">
        <!-- Quick filter chips -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Schnellfilter:" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"/>
          <Button Content="Alle" Command="{Binding SetFilterAllCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipAllBg}" Foreground="{Binding FilterChipAllFg}"/>
          <Button Content="Offen" Command="{Binding SetFilterOpenCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipOpenBg}" Foreground="{Binding FilterChipOpenFg}"/>
          <Button Content="In Bearbeitung" Command="{Binding SetFilterInProgressCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipInProgressBg}" Foreground="{Binding FilterChipInProgressFg}"/>
          <Button Content="Erledigt" Command="{Binding SetFilterCompletedCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipCompletedBg}" Foreground="{Binding FilterChipCompletedFg}"/>
        </StackPanel>

        <!-- Main filter row -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Status:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{x:Static vm:MmViewModel.StatusFilterOptions}"
                    SelectedItem="{Binding FilterStatusOption}"
                    MinWidth="150">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MmStatusOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Straße:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Text="{Binding FilterStreet}" PlaceholderText="Straße filtern…" Width="180"/>

          <Button Content="Suchen" Command="{Binding LoadMessagesCommand}"/>
          <TextBlock Text="{Binding TotalMessages, StringFormat='Gesamt: {0}'}"
                     VerticalAlignment="Center" Foreground="#4A5568"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ════════════════════════════  Fehler / Fortschritt  ════════════════════════════ -->
    <Grid Grid.Row="2">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Bottom"/>
    </Grid>

    <!-- ═══════════════════════════════  Eingabe-Formular  ═════════════════════════════ -->
    <Border Grid.Row="3" IsVisible="{Binding IsFormVisible}"
            Background="#F0F4F8" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="6" Padding="14">
      <StackPanel Spacing="10">

        <!-- Formular-Titel -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock FontSize="15" FontWeight="SemiBold"
                     Text="Neue Mängelmeldung"
                     IsVisible="{Binding IsEditingMessage, Converter={x:Static BoolConverters.Not}}"/>
          <TextBlock FontSize="15" FontWeight="SemiBold"
                     Text="Mängelmeldung bearbeiten"
                     IsVisible="{Binding IsEditingMessage}"/>
        </StackPanel>

        <!-- Fehlermeldung -->
        <TextBlock Text="{Binding FormError}" Foreground="Red"
                   IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Zeile 1: Betreff (volle Breite) -->
        <Grid ColumnDefinitions="130,8,*">
          <TextBlock Grid.Column="0" Text="Betreff *" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox   Grid.Column="2" Text="{Binding FormBetreff}" PlaceholderText="Betreff der Meldung (Pflichtfeld)"/>
        </Grid>

        <!-- Zeile 2: Straße + Wohnung -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="Straße" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="2"
                     ItemsSource="{Binding StreetOptions}"
                     Text="{Binding FormStreet}"
                     IsEditable="True"
                     HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Column="4" Text="Wohnung" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="6" Text="{Binding FormWhg}" PlaceholderText="z. B. 3 OG links"/>
        </Grid>

        <!-- Zeile 3: Melder + Dringlichkeit -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="Melder" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="2"
                     ItemsSource="{Binding MelderOptions}"
                     Text="{Binding FormMelder}"
                     IsEditable="True"
                     HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Column="4" Text="Dringlichkeit" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="6"
                     ItemsSource="{x:Static vm:MmViewModel.DringlichkeitOptions}"
                     SelectedItem="{Binding FormDringlichkeit}"
                     MinWidth="120"/>
        </Grid>

        <!-- Zeile 4: Telefon + E-Mail -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="Telefon" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="2" Text="{Binding FormTel}" PlaceholderText="Rückrufnummer"/>
          <TextBlock Grid.Column="4" Text="E-Mail" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="6" Text="{Binding FormEmail}" PlaceholderText="E-Mail-Adresse"/>
        </Grid>

        <!-- Zeile 5: Nachunternehmer + Zugehörigkeit -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="Nachunternehmer" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="2"
                     ItemsSource="{Binding ContractorOptions}"
                     Text="{Binding FormNachunternehmer}"
                     IsEditable="True"
                     HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Column="4" Text="Zugehörigkeit" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="6" Text="{Binding FormZugeh}" PlaceholderText="Zugehörigkeit"/>
        </Grid>

        <!-- Zeile 6: Meldungstext -->
        <TextBlock Text="Meldungstext" FontWeight="SemiBold"/>
        <TextBox Text="{Binding FormMeldung}"
                 PlaceholderText="Beschreibung der Mängelmeldung…"
                 Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>

        <!-- Aktions-Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Speichern" Command="{Binding SaveCommand}"/>
          <Button Content="Abbrechen" Command="{Binding CancelFormCommand}"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSaving}" Width="80" Height="16" VerticalAlignment="Center"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ═══════════════════════════════  Meldungs-Liste  ═══════════════════════════════ -->
    <Grid Grid.Row="4">
      <DataGrid ItemsSource="{Binding Messages}"
                SelectedItem="{Binding SelectedMessage}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="UID"       Binding="{Binding Uid}"      Width="130"/>
          <DataGridTextColumn Header="Betreff"   Binding="{Binding Betreff}"  Width="*"/>
          <DataGridTextColumn Header="Straße"    Binding="{Binding Street}"   Width="160"/>
          <DataGridTextColumn Header="Whg"       Binding="{Binding Whg}"      Width="60"/>
          <DataGridTextColumn Header="Melder"    Binding="{Binding Melder}"   Width="130"/>
          <DataGridTextColumn Header="Datum"     Binding="{Binding Datetime}" Width="140"/>
          <DataGridTemplateColumn Header="Status" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="api:MmMessage">
                <Border Background="{Binding StatusColorHex}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Dringlichkeit" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="api:MmMessage">
                <Border Background="{Binding DringlichkeitColorHex}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DringlichkeitText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <controls:EmptyStateView Icon="🔧"
                               Title="Keine Mängelmeldungen gefunden"
                               Message="Passe die Filter an oder lege eine neue Meldung an."
                               ActionText="Neue Meldung"
                               ActionCommand="{Binding ShowCreateFormCommand}"
                               IsVisible="{Binding HasNoMessages}"/>
    </Grid>

    <GridSplitter Grid.Row="5" Height="4" HorizontalAlignment="Stretch"/>

    <!-- ═══════════════════════════════  Detail-Panel  ══════════════════════════════════ -->
    <ScrollViewer Grid.Row="6" MaxHeight="240">
      <StackPanel Margin="4" Spacing="10"
                  IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}">

        <TextBlock Text="Detail" FontSize="15" FontWeight="SemiBold"/>

        <Grid ColumnDefinitions="160,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">

          <!-- UID + Datum -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="UID:" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedDetail.Uid}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Erfasst am:" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDetail.Datetime}"/>

          <!-- Betreff + Meldungstext -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Betreff:" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedDetail.Betreff}" TextWrapping="Wrap"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Meldungstext:" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedDetail.MeldungMassage}" TextWrapping="Wrap"/>

          <!-- Kontakt -->
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Telefon / E-Mail:" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding SelectedDetail.Tel}"/>
            <TextBlock Text="{Binding SelectedDetail.Email}" Foreground="#2B6CB0"/>
          </StackPanel>

          <!-- Status-Schnellbearbeitung -->
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Status ändern:" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{x:Static vm:MmViewModel.StatusEditOptions}"
                      SelectedItem="{Binding DetailStatusOption}"
                      MinWidth="160">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MmStatusOption">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Status speichern" Command="{Binding UpdateStatusCommand}"/>
          </StackPanel>

          <!-- Nachunternehmer-Schnellzuweisung -->
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Nachunternehmer:" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding DetailNachunternehmer}" PlaceholderText="Name des Nachunternehmers…" Width="220"/>
            <Button Content="Zuweisen" Command="{Binding AssignContractorCommand}"/>
            <TextBlock Text="{Binding SelectedDetail.Nachunternehmer}" Foreground="#2D3748" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Aktueller Status (Anzeige) -->
          <TextBlock Grid.Row="7" Grid.Column="0" Text="Aktueller Status:" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding SelectedDetail.StatusText}" FontWeight="SemiBold"/>

        </Grid>
      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
