<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:DkcDesktopClient.App.I18n"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             xmlns:proto="using:DkcDesktopClient.Core.Protocol"
             xmlns:api="using:DkcDesktopClient.Core.Api"
             xmlns:controls="using:DkcDesktopClient.App.Controls"
             x:Class="DkcDesktopClient.App.Views.MmView"
             x:DataType="vm:MmViewModel">

  <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto, 6, Auto" Margin="16" RowSpacing="8">

    <!-- ═══════════════════════════════════  Toolbar  ═══════════════════════════════════ -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{i18n:T desktop.nav.mm}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="{i18n:T desktop.common.load}" Command="{Binding LoadMessagesCommand}"/>
      <Button Content="{i18n:T desktop.mm.new}" Command="{Binding ShowCreateFormCommand}"/>
      <Button Content="{i18n:T desktop.common.edit}" Command="{Binding ShowEditFormCommand}"/>
      <Button Content="{i18n:T desktop.common.delete}" Command="{Binding DeleteCommand}" Foreground="Red"/>
      <Button Content="{i18n:T desktop.common.csv_export}" Command="{Binding ExportMessagesToCsvCommand}"
              ToolTip.Tip="{i18n:T desktop.mm.export_tip}"/>
    </StackPanel>

    <!-- ═══════════════════════════════  Filter-Leiste  ════════════════════════════════ -->
    <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Spacing="6">
        <!-- Quick filter chips -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{i18n:T desktop.mm.quick_filter}" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"/>
          <Button Content="{i18n:T desktop.common.all}" Command="{Binding SetFilterAllCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipAllBg}" Foreground="{Binding FilterChipAllFg}"/>
          <Button Content="{i18n:T desktop.common.open}" Command="{Binding SetFilterOpenCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipOpenBg}" Foreground="{Binding FilterChipOpenFg}"/>
          <Button Content="{i18n:T desktop.common.in_progress}" Command="{Binding SetFilterInProgressCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipInProgressBg}" Foreground="{Binding FilterChipInProgressFg}"/>
          <Button Content="{i18n:T desktop.common.done}" Command="{Binding SetFilterCompletedCommand}"
                  Padding="10,3" FontSize="12"
                  Background="{Binding FilterChipCompletedBg}" Foreground="{Binding FilterChipCompletedFg}"/>
        </StackPanel>

        <!-- Main filter row -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{i18n:T desktop.common.status_label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{x:Static vm:MmViewModel.StatusFilterOptions}"
                    SelectedItem="{Binding FilterStatusOption}"
                    MinWidth="140">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MmStatusOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{i18n:T desktop.common.urgency_label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{x:Static vm:MmViewModel.DringlichkeitFilterOptions}"
                    SelectedItem="{Binding FilterDringlichkeitOption}"
                    MinWidth="130">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MmFilterOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{i18n:T desktop.common.street_label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Text="{Binding FilterStreet}" PlaceholderText="{i18n:T desktop.mm.street_filter}" Width="110"/>

          <TextBlock Text="{i18n:T desktop.common.year_label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Text="{Binding FilterYear}" PlaceholderText="z. B. 2026" Width="80"/>

          <TextBlock Text="{i18n:T desktop.common.sorting_label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{x:Static vm:MmViewModel.SortOptions}"
                    SelectedItem="{Binding SortOption}"
                    MinWidth="140">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MmSortOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Search row -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{i18n:T desktop.common.search_label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Text="{Binding SearchText}" PlaceholderText="{i18n:T desktop.mm.search_placeholder}" Width="260"/>
          <Button Content="{i18n:T desktop.common.search}" Command="{Binding LoadMessagesCommand}" Classes="primary"/>
          <TextBlock Text="{Binding TotalMessages, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.mm.total_count|count}"
                     VerticalAlignment="Center" Foreground="#4A5568"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ════════════════════════════  Fehler / Fortschritt  ════════════════════════════ -->
    <Grid Grid.Row="2">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Bottom"/>
    </Grid>

    <!-- ═══════════════════════════════  Eingabe-Formular  ═════════════════════════════ -->
    <Border Grid.Row="3" IsVisible="{Binding IsFormVisible}"
            Background="#F0F4F8" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="6" Padding="14">
      <StackPanel Spacing="10">

        <!-- Formular-Titel -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock FontSize="15" FontWeight="SemiBold"
                     Text="{i18n:T desktop.dashboard.new_mm}"
                     IsVisible="{Binding IsEditingMessage, Converter={x:Static BoolConverters.Not}}"/>
          <TextBlock FontSize="15" FontWeight="SemiBold"
                     Text="{i18n:T desktop.mm.edit_title}"
                     IsVisible="{Binding IsEditingMessage}"/>
        </StackPanel>

        <!-- Fehlermeldung -->
        <TextBlock Text="{Binding FormError}" Foreground="Red"
                   IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Zeile 1: Betreff (volle Breite) -->
        <Grid ColumnDefinitions="130,8,*">
          <TextBlock Grid.Column="0" Text="{i18n:T desktop.mm.subject_required}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox   Grid.Column="2" Text="{Binding FormBetreff}" PlaceholderText="{i18n:T desktop.mm.subject_placeholder}"/>
        </Grid>

        <!-- Zeile 2: Straße + Wohnung -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="{i18n:T desktop.common.street}" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="2"
                     ItemsSource="{Binding StreetChoices}"
                     SelectedItem="{Binding FormStreetChoice}"
                     HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="proto:MmFormOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Column="4" Text="{i18n:T desktop.common.apartment}" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="6"
                     ItemsSource="{Binding WhgChoices}"
                     SelectedItem="{Binding FormWhgChoice}"
                     HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="proto:MmWhgItem">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <TextBlock Text="{Binding TenantHint}" Foreground="#4A5568" FontSize="12"
                   IsVisible="{Binding TenantHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Zeile 3: Melder + Dringlichkeit -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="{i18n:T desktop.common.reporter}" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="2"
                     ItemsSource="{Binding MelderOptions}"
                     Text="{Binding FormMelder}"
                     IsEditable="True"
                     HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Column="4" Text="{i18n:T desktop.common.urgency}" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="6"
                     ItemsSource="{x:Static vm:MmViewModel.DringlichkeitOptions}"
                     SelectedItem="{Binding FormDringlichkeit}"
                     MinWidth="120"/>
        </Grid>

        <!-- Zeile 4: Telefon + E-Mail -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="{i18n:T desktop.common.phone}" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="2" Text="{Binding FormTel}" PlaceholderText="{i18n:T desktop.mm.callback_number}"/>
          <TextBlock Grid.Column="4" Text="{i18n:T desktop.common.email}" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="6" Text="{Binding FormEmail}" PlaceholderText="{i18n:T desktop.common.email_address}"/>
        </Grid>

        <!-- Zeile 5: Nachunternehmer + Zugehörigkeit -->
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="{i18n:T desktop.common.contractor}" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="2"
                     ItemsSource="{Binding ContractorChoices}"
                     SelectedItem="{Binding FormContractorChoice}"
                     HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="proto:MmFormOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Column="4" Text="{i18n:T desktop.common.membership}" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="6" Text="{Binding FormZugeh}" PlaceholderText="{i18n:T desktop.common.membership}"/>
        </Grid>

        <!-- Zeile 6: Meldungstext -->
        <TextBlock Text="{i18n:T desktop.mm.report_text}" FontWeight="SemiBold"/>
        <controls:HtmlEditorControl HtmlContent="{Binding FormMeldung}" MinHeight="140"/>

        <!-- Fotos und Benachrichtigung (nur beim Anlegen, Web-Pendant: Bilder + notify_email) -->
        <StackPanel Spacing="6" IsVisible="{Binding !IsEditingMessage}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{i18n:T desktop.mm.add_photos}" Command="{Binding AddPhotosCommand}"/>
            <TextBlock Text="{Binding FormPhotos.Count, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.mm.photo_count|count}"
                       VerticalAlignment="Center" Foreground="#4A5568"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding FormPhotos}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                  <Button Content="✕" Padding="6,0"
                          Command="{Binding $parent[ItemsControl].((vm:MmViewModel)DataContext).RemovePhotoCommand}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox IsChecked="{Binding FormSuppressTenantEmail}"
                    Content="{i18n:T desktop.mm.no_confirmation}"/>
        </StackPanel>

        <!-- Aktions-Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{i18n:T desktop.common.save}" Command="{Binding SaveCommand}"/>
          <Button Content="{i18n:T desktop.common.cancel}" Command="{Binding CancelFormCommand}"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSaving}" Width="80" Height="16" VerticalAlignment="Center"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ═══════════════════════════════  Meldungs-Liste  ═══════════════════════════════ -->
    <Grid Grid.Row="4">
      <DataGrid ItemsSource="{Binding Messages}"
                SelectedItem="{Binding SelectedMessage}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{i18n:T desktop.mm.uid}"       Binding="{Binding Uid}"      Width="130"/>
          <DataGridTextColumn Header="{i18n:T desktop.mm.subject}"   Binding="{Binding Betreff}"  Width="*"/>
          <DataGridTextColumn Header="{i18n:T desktop.mm.object}"    Binding="{Binding StreetName}" Width="150"/>
          <DataGridTextColumn Header="{i18n:T desktop.mm.apartment_short}"       Binding="{Binding Whg}"      Width="60"/>
          <DataGridTextColumn Header="{i18n:T desktop.common.reporter}"    Binding="{Binding Melder}"   Width="130"/>
          <DataGridTextColumn Header="{i18n:T desktop.common.contractor}" Binding="{Binding NachunternehmerName}" Width="150"/>
          <DataGridTextColumn Header="{i18n:T desktop.mm.followups}" Binding="{Binding FollowupCount}" Width="55"/>
          <DataGridTextColumn Header="{i18n:T desktop.common.date}"     Binding="{Binding Datetime}" Width="140"/>
          <DataGridTemplateColumn Header="{i18n:T desktop.common.status}" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="api:MmMessage">
                <Border Background="{Binding StatusColorHex}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{i18n:T desktop.common.urgency}" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="api:MmMessage">
                <Border Background="{Binding DringlichkeitColorHex}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DringlichkeitText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <controls:EmptyStateView Icon="🔧"
                               Title="{i18n:T desktop.mm.empty}"
                               Message="Passe die Filter an oder lege eine neue Meldung an."
                               ActionText="Neue Meldung"
                               ActionCommand="{Binding ShowCreateFormCommand}"
                               IsVisible="{Binding HasNoMessages}"/>
    </Grid>

    <!-- ═══════════════════════════════════  Pagination  ════════════════════════════════ -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
      <Button Content="{i18n:T desktop.mm.prev_page}" Command="{Binding PreviousPageCommand}"/>
      <TextBlock VerticalAlignment="Center" Foreground="#4A5568">
        <TextBlock.Text>
          <MultiBinding Converter="{x:Static i18n:Labels.FormatMany}" ConverterParameter="desktop.mm.page_of|page|pages">
            <Binding Path="CurrentPageNumber"/>
            <Binding Path="TotalPages"/>
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <Button Content="{i18n:T desktop.mm.next_page}" Command="{Binding NextPageCommand}"/>
    </StackPanel>

    <GridSplitter Grid.Row="6" Height="4" HorizontalAlignment="Stretch"/>

    <!-- ═══════════════════════════════  Detail-Panel  ══════════════════════════════════ -->
    <ScrollViewer Grid.Row="7" MaxHeight="420">
      <StackPanel Margin="4" Spacing="10"
                  IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}">

        <TextBlock Text="{i18n:T desktop.common.detail}" FontSize="15" FontWeight="SemiBold"/>

        <Grid ColumnDefinitions="160,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">

          <!-- UID + Datum -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:T desktop.mm.uid_label}" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedDetail.Uid}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:T desktop.mm.created_label}" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDetail.Datetime}"/>

          <!-- Objekt / Wohnung -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:T desktop.mm.object_apartment_label}" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding SelectedDetail.StreetName}"/>
            <TextBlock Text="{Binding SelectedDetail.Whg, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.mm.apartment_suffix|number}"/>
          </StackPanel>

          <!-- Betreff + Meldungstext -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="{i18n:T desktop.mm.subject_label}" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedDetail.Betreff}" TextWrapping="Wrap"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="{i18n:T desktop.mm.report_text_label}" FontWeight="SemiBold" VerticalAlignment="Top"/>
          <controls:HtmlDisplayControl Grid.Row="4" Grid.Column="2" HtmlContent="{Binding SelectedDetail.MeldungMassage}" MaxHeight="120"/>

          <!-- Kontakt -->
          <TextBlock Grid.Row="5" Grid.Column="0" Text="{i18n:T desktop.mm.contact_label}" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding SelectedDetail.Tel}"/>
            <TextBlock Text="{Binding SelectedDetail.Email}" Foreground="#2B6CB0"/>
          </StackPanel>

          <!-- Zeit / Planon-Gruppe / Zusatzanweisungen (Web-Pendant: mm_view.tpl Prüfungs-/Freigabe-Daten) -->
          <TextBlock Grid.Row="6" Grid.Column="0" Text="{i18n:T desktop.mm.time_planon_label}" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Spacing="12"
                      IsVisible="{Binding SelectedDetail.Zeit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding SelectedDetail.Zeit, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.mm.minutes|count}"/>
            <TextBlock Text="{Binding SelectedDetail.Planon}" Foreground="#4A5568"/>
          </StackPanel>
          <ItemsControl Grid.Row="7" Grid.Column="2" ItemsSource="{Binding SelectedDetail.Instructions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="{i18n:T desktop.mm.extra_instructions_label}" FontWeight="SemiBold" VerticalAlignment="Top"/>

          <!-- Status-Schnellbearbeitung -->
          <TextBlock Grid.Row="8" Grid.Column="0" Text="{i18n:T desktop.mm.change_status_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{x:Static vm:MmViewModel.StatusEditOptions}"
                      SelectedItem="{Binding DetailStatusOption}"
                      MinWidth="160">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MmStatusOption">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding DetailStatusComment}" PlaceholderText="{i18n:T desktop.mm.status_comment_placeholder}" Width="220"/>
            <Button Content="{i18n:T desktop.klima.save_state}" Command="{Binding UpdateStatusCommand}"/>
          </StackPanel>

          <!-- Nachunternehmer-Schnellzuweisung -->
          <TextBlock Grid.Row="9" Grid.Column="0" Text="{i18n:T desktop.mm.contractor_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="9" Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding ContractorChoices}" SelectedItem="{Binding DetailContractorChoice}"
                      PlaceholderText="{i18n:T desktop.mm.contractor_placeholder}" MinWidth="220">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="proto:MmFormOption"><TextBlock Text="{Binding Name}"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{i18n:T desktop.mm.assign}" Command="{Binding AssignContractorCommand}"/>
            <TextBlock Text="{Binding SelectedDetail.NachunternehmerName}" Foreground="#2D3748" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Freigabe-/Prüfungs-Workflow (Web-Pendant: Status-/Prüfungs-Modal mm_list.tpl) —
               nur relevant, wenn oben Status "Freigabe" oder "Freigegeben" gewählt ist. -->
          <TextBlock Grid.Row="10" Grid.Column="0" Text="{i18n:T desktop.mm.approval_workflow_label}" FontWeight="SemiBold" VerticalAlignment="Top"
                     IsVisible="{Binding IsFreigabeWorkflowVisible}"/>
          <StackPanel Grid.Row="10" Grid.Column="2" Spacing="6" IsVisible="{Binding IsFreigabeWorkflowVisible}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding DetailEkpreis}" PlaceholderText="{i18n:T desktop.mm.purchase_price}" Width="100"/>
              <TextBox Text="{Binding DetailPlanonGruppe}" PlaceholderText="{i18n:T desktop.mm.planon_group}" Width="220"/>
              <TextBox Text="{Binding DetailAktNr}" PlaceholderText="{i18n:T desktop.mm.approval_no}" Width="140"/>
            </StackPanel>
            <TextBox Text="{Binding DetailFolge}" PlaceholderText="{i18n:T desktop.mm.followup_measures}" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>
          </StackPanel>

          <TextBlock Grid.Row="11" Grid.Column="0" Text="{i18n:T desktop.mm.extra_instructions_label}" FontWeight="SemiBold" VerticalAlignment="Top"
                     IsVisible="{Binding IsFreigabeWorkflowVisible}"/>
          <ItemsControl Grid.Row="11" Grid.Column="2" ItemsSource="{Binding DetailInstructionOptions}"
                        IsVisible="{Binding IsFreigabeWorkflowVisible}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MmInstructionCheckboxItem">
                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected}" Margin="0,0,12,6" MaxWidth="260"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Erledigt-Workflow — nur relevant, wenn oben Status "Erledigt" gewählt ist. -->
          <TextBlock Grid.Row="12" Grid.Column="0" Text="{i18n:T desktop.mm.order_number_label}" FontWeight="SemiBold" VerticalAlignment="Center"
                     IsVisible="{Binding IsErledigtWorkflowVisible}"/>
          <TextBox Grid.Row="12" Grid.Column="2" Text="{Binding DetailAuftragsnummer}" Width="180" HorizontalAlignment="Left"
                   PlaceholderText="{i18n:T desktop.mm.order_number_placeholder}"
                   IsVisible="{Binding IsErledigtWorkflowVisible}"
                   ToolTip.Tip="{i18n:T desktop.mm.order_number_tip}"/>

        </Grid>
      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
