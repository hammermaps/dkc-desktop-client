<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:DkcDesktopClient.App.I18n"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             x:Class="DkcDesktopClient.App.Views.KeysView"
             x:DataType="vm:KeysViewModel">
  <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *" Margin="16" RowSpacing="8">

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{i18n:T desktop.keys.title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="{i18n:T desktop.common.refresh}" Command="{Binding LoadDataCommand}"/>
      <Separator Width="1" Background="#CCCCCC" Margin="4,0"/>
      <Button Content="{i18n:T desktop.common.new}" Command="{Binding ShowCreateKeyFormCommand}"/>
      <Button Content="{i18n:T desktop.common.edit}" Command="{Binding ShowEditKeyFormCommand}"/>
      <Button Content="{i18n:T desktop.common.delete}" Command="{Binding DeleteKeyCommand}" Foreground="Red"/>
      <Button Content="{i18n:T desktop.keys.issue}" Command="{Binding ShowIssueFormCommand}"/>
      <Button Name="KeyHistoryButton" Content="{i18n:T desktop.keys.history}" Command="{Binding LoadKeyHistoryCommand}"
              ToolTip.Tip="{i18n:T desktop.keys.history_tip}"/>
      <Separator Width="1" Background="#CCCCCC" Margin="4,0"/>
      <Button Content="{i18n:T desktop.keys.return}" Command="{Binding ShowReturnFormCommand}"/>
      <Separator Width="1" Background="#CCCCCC" Margin="4,0"/>
      <Button Content="{i18n:T desktop.common.csv_export}" Command="{Binding ExportInventoryToCsvCommand}"
              ToolTip.Tip="{i18n:T desktop.keys.export_tip}"/>
    </StackPanel>

    <!-- Stats tiles -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,0">
      <Border Background="#90CDF4" BorderBrush="#63B3ED" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{i18n:T desktop.keys.key_types}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding StatTotalKeyTypes}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Background="#9AE6B4" BorderBrush="#68D391" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{i18n:T desktop.common.total}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding StatTotalKeys}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Background="#FBD38D" BorderBrush="#F6AD55" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{i18n:T desktop.keys.issued}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding StatIssuedKeys}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Background="#D6BCFA" BorderBrush="#B794F4" BorderThickness="1" CornerRadius="4" Padding="12">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{i18n:T desktop.keys.available}" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding StatAvailableKeys}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Error / Progress -->
    <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" VerticalAlignment="Bottom"/>

    <!-- Key create/edit form -->
    <Border Grid.Row="3" IsVisible="{Binding IsKeyFormVisible}"
            Background="#CBD5E0" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="4" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="{i18n:T desktop.keys.key_type}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding KeyFormError}" Foreground="Red"
                   IsVisible="{Binding KeyFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <Grid ColumnDefinitions="100,8,*,16,80,8,Auto" RowDefinitions="Auto,8,Auto,8,Auto" RowSpacing="0">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:T desktop.common.name_required}" VerticalAlignment="Center"/>
          <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding FormKeyName}" PlaceholderText="{i18n:T desktop.keys.name_placeholder}"/>
          <TextBlock Grid.Row="0" Grid.Column="4" Text="{i18n:T desktop.common.total}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Row="0" Grid.Column="6" Value="{Binding FormKeyTotal}" Minimum="1" Maximum="999" Width="80"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:T desktop.keys.number_required}" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FormKeyNumber}" PlaceholderText="{i18n:T desktop.keys.number_placeholder}"/>
          <TextBlock Grid.Row="2" Grid.Column="4" Text="{i18n:T desktop.keys.type_required}" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="2" Grid.Column="6" ItemsSource="{Binding KeyTypeOptions}" SelectedItem="{Binding FormKeyType}" MinWidth="140">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="{i18n:T desktop.keys.cabinet}" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding KeyCabinetOptions}" SelectedItem="{Binding FormKeyCabinet}" MinWidth="160" HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="4" Grid.Column="4" Text="{i18n:T desktop.common.description}" VerticalAlignment="Top" Margin="0,4,0,0"/>
          <TextBox Grid.Row="4" Grid.Column="6" Text="{Binding FormKeyDescription}"
                   PlaceholderText="{i18n:T desktop.common.description_optional}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Width="220"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{i18n:T desktop.common.save}" Command="{Binding SaveKeyCommand}"/>
          <Button Content="{i18n:T desktop.common.cancel}" Command="{Binding CancelKeyFormCommand}"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingKey}" Width="80" Height="16" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Issue form -->
    <Border Grid.Row="4" IsVisible="{Binding IsIssueFormVisible}"
            Background="#FAF089" BorderThickness="1" BorderBrush="#F6C90E" CornerRadius="4" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding SelectedInventoryItem.Name, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.keys.issue_title|name}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding IssueFormError}" Foreground="Red"
                   IsVisible="{Binding IssueFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <Grid ColumnDefinitions="100,8,*,16,100,8,*" RowDefinitions="Auto,8,Auto" RowSpacing="0">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:T desktop.keys.recipient_required}" VerticalAlignment="Center"/>
          <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding FormIssuedTo}" PlaceholderText="{i18n:T desktop.keys.recipient_placeholder}"/>
          <TextBlock Grid.Row="0" Grid.Column="4" Text="{i18n:T desktop.common.date_required}" VerticalAlignment="Center"/>
          <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding FormIssuedAt}" PlaceholderText="{i18n:T desktop.common.date_placeholder}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:T desktop.common.notes}" VerticalAlignment="Top" Margin="0,4,0,0"/>
          <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" Text="{Binding FormIssueNotes}"
                   PlaceholderText="{i18n:T desktop.common.optional_notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{i18n:T desktop.keys.issue}" Command="{Binding IssueKeyCommand}"/>
          <Button Content="{i18n:T desktop.common.cancel}" Command="{Binding CancelIssueFormCommand}"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingIssue}" Width="80" Height="16" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Return form -->
    <Border Grid.Row="4" IsVisible="{Binding IsReturnFormVisible}"
            Background="#C6F6D5" BorderThickness="1" BorderBrush="#68D391" CornerRadius="4" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding SelectedIssuedItem.KeyName, Converter={x:Static i18n:Labels.Format}, ConverterParameter=desktop.keys.return_title|name}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ReturnFormError}" Foreground="Red"
                   IsVisible="{Binding ReturnFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <Grid ColumnDefinitions="130,8,*,16,130,8,*">
          <TextBlock Grid.Column="0" Text="{i18n:T desktop.keys.return_date_required}" VerticalAlignment="Center"/>
          <TextBox   Grid.Column="2" Text="{Binding FormReturnDate}" PlaceholderText="{i18n:T desktop.common.date_placeholder}"/>
          <TextBlock Grid.Column="4" Text="{i18n:T desktop.common.notes}" VerticalAlignment="Top" Margin="0,4,0,0"/>
          <TextBox   Grid.Column="6" Text="{Binding FormReturnNotes}"
                     PlaceholderText="{i18n:T desktop.common.optional_notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{i18n:T desktop.keys.confirm_return}" Command="{Binding ReturnKeyCommand}"/>
          <Button Content="{i18n:T desktop.common.cancel}" Command="{Binding CancelReturnFormCommand}"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingReturn}" Width="80" Height="16" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Tabs -->
    <TabControl Grid.Row="5" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="{i18n:T desktop.keys.inventory}">
        <DataGrid ItemsSource="{Binding Inventory}" SelectedItem="{Binding SelectedInventoryItem}"
                  IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{i18n:T desktop.common.id}" Binding="{Binding Id}" Width="60"/>
            <DataGridTextColumn Header="{i18n:T desktop.common.name}" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="{i18n:T desktop.common.description}" Binding="{Binding Description}" Width="*"/>
            <DataGridTextColumn Header="{i18n:T desktop.common.total}" Binding="{Binding Total}" Width="70"/>
            <DataGridTextColumn Header="{i18n:T desktop.keys.available}" Binding="{Binding Available}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{i18n:T desktop.keys.issued_keys}">
        <DataGrid ItemsSource="{Binding IssuedKeys}" SelectedItem="{Binding SelectedIssuedItem}"
                  IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{i18n:T desktop.common.id}" Binding="{Binding Id}" Width="60"/>
            <DataGridTextColumn Header="{i18n:T desktop.keys.key_name}" Binding="{Binding KeyName}" Width="*"/>
            <DataGridTextColumn Header="{i18n:T desktop.keys.issued_to}" Binding="{Binding IssuedTo}" Width="*"/>
            <DataGridTextColumn Header="{i18n:T desktop.keys.issued_at}" Binding="{Binding IssuedAt}" Width="130"/>
            <DataGridTextColumn Header="{i18n:T desktop.keys.returned_at}" Binding="{Binding ReturnedAt}" Width="130"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{Binding KeyHistoryTitle}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Name="KeyHistoryInfoText" Text="{Binding KeyHistoryInfo}" Opacity="0.75" Margin="0,4"/>
          <DataGrid Name="KeyHistoryGrid" ItemsSource="{Binding KeyHistory}" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{i18n:T desktop.common.issued_at}" Binding="{Binding IssuedAt}" Width="140"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.recipient}" Binding="{Binding Recipient}" Width="*"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.return_planned}" Binding="{Binding PlannedReturnAt}" Width="120"/>
              <DataGridTextColumn Header="{i18n:T desktop.keys.returned_at}" Binding="{Binding ReturnedAt}" Width="140"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.status}" Binding="{Binding State}" Width="90"/>
              <DataGridTextColumn Header="{i18n:T desktop.common.notes}" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>

  </Grid>
</UserControl>
