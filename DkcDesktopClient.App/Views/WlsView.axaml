<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DkcDesktopClient.App.ViewModels"
             x:Class="DkcDesktopClient.App.Views.WlsView"
             x:DataType="vm:WlsViewModel">

  <Grid RowDefinitions="Auto, Auto, *" Margin="16" RowSpacing="8">

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="WLS – Wohnungsleerstandserfassung" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="100" Height="3" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Error -->
    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Tab Control -->
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ══════════════════════  Tab: Gebäude  ══════════════════════════════ -->
      <TabItem Header="🏢 Gebäude">
        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="8" Margin="4">

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Laden" Command="{Binding LoadBuildingsCommand}"/>
            <Button Content="Neu" Command="{Binding ShowCreateBuildingFormCommand}"/>
            <Button Content="Bearbeiten" Command="{Binding ShowEditBuildingFormCommand}"/>
            <Button Content="Löschen" Command="{Binding DeleteBuildingCommand}" Foreground="Red"/>
          </StackPanel>

          <!-- Building form -->
          <Border Grid.Row="1" IsVisible="{Binding IsBuildingFormVisible}"
                  Background="#F0F4F8" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="6" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock FontSize="14" FontWeight="SemiBold"
                         Text="Neues Gebäude" IsVisible="{Binding IsEditingBuilding, Converter={x:Static BoolConverters.Not}}"/>
              <TextBlock FontSize="14" FontWeight="SemiBold"
                         Text="Gebäude bearbeiten" IsVisible="{Binding IsEditingBuilding}"/>
              <TextBlock Text="{Binding BuildingFormError}" Foreground="Red"
                         IsVisible="{Binding BuildingFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Grid ColumnDefinitions="120,8,*,24,Auto,8,Auto">
                <TextBlock Grid.Column="0" Text="Name *" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="2" Text="{Binding FormBuildingName}" PlaceholderText="Gebäudename"/>
                <TextBlock Grid.Column="4" Text="Versteckt" VerticalAlignment="Center"/>
                <CheckBox  Grid.Column="6" IsChecked="{Binding FormBuildingHidden}"/>
              </Grid>
              <Grid ColumnDefinitions="120,8,120">
                <TextBlock Grid.Column="0" Text="Sortierung" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="2" Value="{Binding FormBuildingSorted}" Minimum="0" Maximum="9999" Increment="1" FormatString="0"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Speichern" Command="{Binding SaveBuildingCommand}"/>
                <Button Content="Abbrechen" Command="{Binding CancelBuildingFormCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingBuilding}" Width="60" Height="14" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Building list -->
          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding Buildings}"
                    SelectedItem="{Binding SelectedBuilding}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID"          Binding="{Binding Id}"             Width="60"/>
              <DataGridTextColumn Header="Name"        Binding="{Binding Name}"           Width="*"/>
              <DataGridTextColumn Header="Wohnungen"   Binding="{Binding ApartmentsCount}" Width="90"/>
              <DataGridTextColumn Header="Versteckt"   Binding="{Binding Hidden}"         Width="80"/>
              <DataGridTextColumn Header="Sortierung"  Binding="{Binding Sorted}"         Width="80"/>
              <DataGridTextColumn Header="Erstellt"    Binding="{Binding Created}"        Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ══════════════════════  Tab: Wohnungen  ════════════════════════════ -->
      <TabItem Header="🏠 Wohnungen">
        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="8" Margin="4">

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Laden" Command="{Binding LoadApartmentsCommand}"/>
            <Button Content="Neu" Command="{Binding ShowCreateApartmentFormCommand}"/>
            <Button Content="Bearbeiten" Command="{Binding ShowEditApartmentFormCommand}"/>
            <Button Content="Löschen" Command="{Binding DeleteApartmentCommand}" Foreground="Red"/>
            <TextBlock Text="{Binding SelectedBuilding.Name, StringFormat='Gebäude: {0}'}"
                       VerticalAlignment="Center" Foreground="#4A5568" FontStyle="Italic"
                       IsVisible="{Binding SelectedBuilding, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>

          <!-- Apartment form -->
          <Border Grid.Row="1" IsVisible="{Binding IsApartmentFormVisible}"
                  Background="#F0F4F8" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="6" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock FontSize="14" FontWeight="SemiBold"
                         Text="Neue Wohnung" IsVisible="{Binding IsEditingApartment, Converter={x:Static BoolConverters.Not}}"/>
              <TextBlock FontSize="14" FontWeight="SemiBold"
                         Text="Wohnung bearbeiten" IsVisible="{Binding IsEditingApartment}"/>
              <TextBlock Text="{Binding ApartmentFormError}" Foreground="Red"
                         IsVisible="{Binding ApartmentFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Grid ColumnDefinitions="120,8,*,16,120,8,*">
                <TextBlock Grid.Column="0" Text="Wohnungsnr. *" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="2" Text="{Binding FormApartmentValue}" PlaceholderText="z. B. 1a"/>
                <TextBlock Grid.Column="4" Text="Bezeichnung" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="6" Text="{Binding FormApartmentName}" PlaceholderText="z. B. Dachgeschoss"/>
              </Grid>
              <Grid ColumnDefinitions="120,8,120,24,Auto,8,Auto">
                <TextBlock Grid.Column="0" Text="Sortierung" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="2" Value="{Binding FormApartmentSorted}" Minimum="0" Maximum="9999" Increment="1" FormatString="0"/>
                <TextBlock Grid.Column="4" Text="Leerstand" VerticalAlignment="Center"/>
                <CheckBox  Grid.Column="6" IsChecked="{Binding FormApartmentEmpty}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Speichern" Command="{Binding SaveApartmentCommand}"/>
                <Button Content="Abbrechen" Command="{Binding CancelApartmentFormCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingApartment}" Width="60" Height="14" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Apartment list -->
          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding Apartments}"
                    SelectedItem="{Binding SelectedApartment}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID"         Binding="{Binding Id}"      Width="60"/>
              <DataGridTextColumn Header="Nummer"     Binding="{Binding Number}"  Width="*"/>
              <DataGridTextColumn Header="Wert"       Binding="{Binding Value}"   Width="100"/>
              <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}"   Width="*"/>
              <DataGridTextColumn Header="Leerstand"  Binding="{Binding Empty}"   Width="90"/>
              <DataGridTextColumn Header="Sortierung" Binding="{Binding Sorted}"  Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ══════════════════════  Tab: Erfassungen  ══════════════════════════ -->
      <TabItem Header="📋 Erfassungen">
        <Grid RowDefinitions="Auto, Auto, Auto, *" RowSpacing="8" Margin="4">

          <!-- Toolbar -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Laden" Command="{Binding LoadRecordsCommand}"/>
            <Button Content="Neu" Command="{Binding ShowCreateRecordFormCommand}"/>
            <Button Content="Bearbeiten" Command="{Binding ShowEditRecordFormCommand}"/>
            <Button Content="Löschen" Command="{Binding DeleteRecordCommand}" Foreground="Red"/>
          </StackPanel>

          <!-- Filter bar -->
          <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Von:" VerticalAlignment="Center"/>
              <TextBox Text="{Binding FilterStartDate}" PlaceholderText="YYYY-MM-DD" Width="120"/>
              <TextBlock Text="Bis:" VerticalAlignment="Center"/>
              <TextBox Text="{Binding FilterEndDate}" PlaceholderText="YYYY-MM-DD" Width="120"/>
              <Button Content="Suchen" Command="{Binding LoadRecordsCommand}"/>
            </StackPanel>
          </Border>

          <!-- Record form -->
          <Border Grid.Row="2" IsVisible="{Binding IsRecordFormVisible}"
                  Background="#F0F4F8" BorderThickness="1" BorderBrush="#CBD5E0" CornerRadius="6" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock FontSize="14" FontWeight="SemiBold"
                         Text="Neue Erfassung" IsVisible="{Binding IsEditingRecord, Converter={x:Static BoolConverters.Not}}"/>
              <TextBlock FontSize="14" FontWeight="SemiBold"
                         Text="Erfassung bearbeiten" IsVisible="{Binding IsEditingRecord}"/>
              <TextBlock Text="{Binding RecordFormError}" Foreground="Red"
                         IsVisible="{Binding RecordFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Grid ColumnDefinitions="120,8,*,16,120,8,*">
                <TextBlock Grid.Column="0" Text="Startzeit *" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="2" Text="{Binding FormRecordStartTime}" PlaceholderText="YYYY-MM-DD HH:MM:SS"/>
                <TextBlock Grid.Column="4" Text="Endzeit" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="6" Text="{Binding FormRecordEndTime}" PlaceholderText="YYYY-MM-DD HH:MM:SS"/>
              </Grid>
              <Grid ColumnDefinitions="120,8,*,16,120,8,*">
                <TextBlock Grid.Column="0" Text="Breitengrad" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="2" Text="{Binding FormRecordLatitude}" PlaceholderText="z. B. 52.1234"/>
                <TextBlock Grid.Column="4" Text="Längengrad" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="6" Text="{Binding FormRecordLongitude}" PlaceholderText="z. B. 13.4567"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Speichern" Command="{Binding SaveRecordCommand}"/>
                <Button Content="Abbrechen" Command="{Binding CancelRecordFormCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSavingRecord}" Width="60" Height="14" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Record list -->
          <DataGrid Grid.Row="3"
                    ItemsSource="{Binding Records}"
                    SelectedItem="{Binding SelectedRecord}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID"         Binding="{Binding Id}"          Width="60"/>
              <DataGridTextColumn Header="Benutzer"   Binding="{Binding UserName}"    Width="150"/>
              <DataGridTextColumn Header="Startzeit"  Binding="{Binding StartTime}"   Width="160"/>
              <DataGridTextColumn Header="Endzeit"    Binding="{Binding EndTime}"     Width="160"/>
              <DataGridTextColumn Header="Dauer"      Binding="{Binding DurationText}" Width="100"/>
              <DataGridTextColumn Header="Breitengrad" Binding="{Binding Latitude}"   Width="110"/>
              <DataGridTextColumn Header="Längengrad"  Binding="{Binding Longitude}"  Width="110"/>
              <DataGridTextColumn Header="Erstellt"   Binding="{Binding CreatedAt}"   Width="160"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
